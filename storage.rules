rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == "vermietung.candybar@gmail.com"
        && request.auth.token.email_verified == true;
    }

    // Bilder sind öffentlich abrufbar; nur das verifizierte Admin-Konto darf verwalten.
    match /{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin()
        && (
          request.resource == null
          || (
            request.resource.size < 8 * 1024 * 1024
            && request.resource.contentType.matches('image/.*')
          )
        );
    }
  }
}
